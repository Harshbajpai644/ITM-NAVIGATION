# Django
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL connection
# Use the connection string from Supabase: Project Settings > Database
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Or set individual Postgres vars (used when DATABASE_URL is empty)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# Use SQLite for local development when USE_SQLITE=True
USE_SQLITE=True

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Default admin (used by scripts/create_admin.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@itm.edu
ADMIN_PASSWORD=Admin@12345

# Campus map center (ITM Campus default)
CAMPUS_LAT=26.1408
CAMPUS_LNG=78.1991